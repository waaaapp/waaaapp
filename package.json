{
  "name": "waaaapp",
  "version": "2.0.0",
  "description": "Multiple WhatsApp accounts in one desktop app.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build": "electron-builder --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:mas": "electron-builder --mac mas --universal --publish never"
  },
  "keywords": [],
  "author": {
    "name": "Chris Ochieng",
    "email": "mail@chrisochieng.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "png2icons": "^2.0.1",
    "sharp": "0.35.5"
  },
  "dependencies": {
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9"
  },
  "build": {
    "appId": "com.waaaapp.app",
    "productName": "waaaapp",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "waaaapp uses your microphone for WhatsApp voice and video calls.",
        "NSCameraUsageDescription": "waaaapp uses your camera for WhatsApp video calls."
      },
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "linux": {
      "icon": "icon.png",
      "category": "Network",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "maintainer": "Chris Ochieng <mail@chrisochieng.com>"
    },
    "files": [
      "main.js",
      "preload.js",
      "account-preload.js",
      "workspace.js",
      "renderer.js",
      "index.html",
      "style.css",
      "icon.*",
      "LICENSE"
    ],
    "artifactName": "waaaapp-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "waaaapp",
        "repo": "waaaapp",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mas": {
      "hardenedRuntime": false,
      "entitlements": "entitlements.mas.plist",
      "entitlementsInherit": "entitlements.mas.inherit.plist"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/waaaapp/waaaapp.git"
  },
  "homepage": "https://github.com/waaaapp/waaaapp",
  "signedMac": false
}
